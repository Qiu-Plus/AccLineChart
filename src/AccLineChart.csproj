<Project Sdk="MuseDash.Mod.Sdk/2.0.0">

    <PropertyGroup>
        <AssemblyName>AccLineChart</AssemblyName>
        <RootNamespace>AccLineChart</RootNamespace>
        <ModName>AccLineChart</ModName>
        <Version>1.0.3</Version>
        <Authors>巯_QiuPlus</Authors>
        <Description>结算页准度曲线：可拖动/缩放的准度变化图，从 100% 起算，Great 黄点、Miss 红点，颜色与窗口位置可保存。无联网、不改存档。</Description>
    </PropertyGroup>

    <!-- Optional: set MD_DEPLOY_DIR to copy the built DLL somewhere after building. -->
    <PropertyGroup Condition="'$(MD_DEPLOY_DIR)' != ''">
        <ModsFolder>$(MD_DEPLOY_DIR)</ModsFolder>
    </PropertyGroup>

</Project>
