<Project Sdk="MuseDash.Mod.Sdk/2.0.0">

    <PropertyGroup>
        <AssemblyName>AccLineChart</AssemblyName>
        <RootNamespace>AccLineChart</RootNamespace>
        <ModName>AccLineChart</ModName>
        <Version>1.5.5</Version>
        <Authors>巯_QiuPlus</Authors>
        <Description>结算页准度曲线：可拖动/缩放的准度变化图，从 100% 起算，Great 黄点、Miss 红点，支持 HEX 取色；多人联机实时显示所有玩家的准度曲线、昵称与头像（进程内只读，不额外连接，不影响联机）。</Description>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- The tap's tiny native detour uses the Iced decoder that MelonLoader already ships
         (part of Il2CppInterop); reference it compile-time only, nothing extra is shipped. -->
    <Target Name="AddIcedReference" BeforeTargets="ResolveAssemblyReferences"
            Condition="'$(GameFolder)' != '' and Exists('$(MelonNET6)Iced.dll')">
        <ItemGroup>
            <Reference Include="Iced">
                <HintPath>$(MelonNET6)Iced.dll</HintPath>
                <Private>false</Private>
            </Reference>
        </ItemGroup>
    </Target>

    <!-- Optional: set MD_DEPLOY_DIR to copy the built DLL somewhere after building. -->
    <PropertyGroup Condition="'$(MD_DEPLOY_DIR)' != ''">
        <ModsFolder>$(MD_DEPLOY_DIR)</ModsFolder>
    </PropertyGroup>

</Project>
